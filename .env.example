# Variables for docker-compose.yml. Copy to `.env` (git-ignored) and fill in.
# For running the backend without Docker, use backend/.env.example instead.

POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ENVIRONMENT=development
# groq (primary, then Gemini, then mock) | gemini | mock. Leave the keys empty to use the offline mock provider.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini API key (secondary provider)
LLM_API_KEY=
LLM_FALLBACK_TO_MOCK=true
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SMTP_ALLOW_PRIVATE_HOSTS=false
# Gmail OAuth (optional). Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/gmail/callback
FRONTEND_URL=http://localhost:3000
# Compose runs a Celery worker; set to sync to send inside the request instead
EMAIL_DELIVERY_MODE=celery
