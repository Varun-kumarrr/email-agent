# Copy this file to `.env` and fill in real values locally.
# NEVER commit your .env file.

# "development" or "production" (production refuses unsafe settings at startup)
ENVIRONMENT=development
LOG_LEVEL=INFO
# Never enable in production: SQL logging (parameters are hidden, but keep logs lean)
SQL_ECHO=false

# PostgreSQL is the only supported database (SQLAlchemy URL, psycopg v3 driver).
# Application database:
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/email_agent
# Separate database used ONLY by the test suite (name must end in _test).
# Tests refuse to run against DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/email_agent_test

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key used to encrypt stored SMTP passwords. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LLM provider: "gemini" (Google Gemini free tier) or "mock" (no API key needed)
LLM_PROVIDER=gemini
# Google AI Studio API key (https://aistudio.google.com/apikey). Leave empty to use the mock provider.
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Fall back to the mock provider (and flag the response) if Gemini fails, e.g. HTTP 503 high demand
LLM_FALLBACK_TO_MOCK=true

# SMTP network timeout and retry backoff (seconds)
SMTP_TIMEOUT_SECONDS=15
SMTP_RETRY_BACKOFF_SECONDS=1
# Email delivery mode: "sync" sends inside the request (no Redis needed);
# "celery" queues a background job for the Celery worker (needs Redis, e.g. from docker compose).
EMAIL_DELIVERY_MODE=sync
REDIS_URL=redis://localhost:6379/0
# Optional; defaults to REDIS_URL
CELERY_BROKER_URL=
# Background retry backoff: base * 2^(attempt-1) seconds, capped
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=900

# Allow SMTP hosts on private/loopback addresses (local test mail servers).
# Must be false in production to prevent SSRF.
SMTP_ALLOW_PRIVATE_HOSTS=true

# Frontend base URL: where the browser returns after connecting an OAuth email account
FRONTEND_URL=http://localhost:3000

# Gmail OAuth: Google Cloud "Web application" OAuth client (see README, "Gmail OAuth").
# Leave the ID/secret empty to disable the "Connect Gmail" feature. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" of the Google client exactly
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/gmail/callback

# Comma-separated list of allowed frontend origins (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:3000
