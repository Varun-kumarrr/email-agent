# Copy this file to `.env` and fill in real values locally.
# NEVER commit your .env file.

# PostgreSQL connection (SQLAlchemy URL, psycopg v3 driver)
# Example format: postgresql+psycopg://<user>:<password>@localhost:5432/email_agent
DATABASE_URL=

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key used to encrypt stored SMTP passwords. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LLM provider: "gemini" (Google Gemini free tier) or "mock" (no API key needed)
LLM_PROVIDER=gemini
# Google AI Studio API key (https://aistudio.google.com/apikey). Leave empty to use the mock provider.
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Comma-separated list of allowed frontend origins (no wildcard in production)
ALLOWED_ORIGINS=http://localhost:3000
